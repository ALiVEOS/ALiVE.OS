                private _vivCargoF = [_event, "airdropVivCargo", []] call ALIVE_fnc_hashGet;
                if (_vivCargoF isNotEqualTo [] && {isNil "ALIVE_ML_vivDone" || {(_vivCargoF findIf { !(_x in ALIVE_ML_vivDone) }) >= 0}}) then {
