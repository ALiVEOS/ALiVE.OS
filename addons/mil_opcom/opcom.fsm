*//*%FSM</HEAD>*/
class FSM
{
        fsmName = "opcom";
        class States
        {
                /*%FSM<STATE "INIT">*/
                class INIT
                {
                        name = "INIT";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "private _OPCOM_status = ""PreInit"";" \n
                         "" \n
                         "private _busy = false;" \n
                         "private _exitFSM = false;" \n
                         "" \n
                         "private _OPCOM_HANDLER = _this select 0;" \n
                         "private _OBJECTIVES = [_OPCOM_HANDLER,""objectives"",[]] call ALiVE_fnc_HashGet;" \n
                         "private _OPCOM_FSM =  [_OPCOM_HANDLER,""OPCOM_FSM""] call ALiVE_fnc_HashGet;" \n
                         "private _TACOM_FSM =  [_OPCOM_HANDLER,""TACOM_FSM""] call ALiVE_fnc_HashGet;" \n
                         "" \n
                         "private _debug = [_OPCOM_HANDLER,""debug"",false] call ALiVE_fnc_HashGet;" \n
                         "private _side = [_OPCOM_HANDLER,""side"",""EAST""] call ALiVE_fnc_HashGet;" \n
                         "private _factions = [_OPCOM_HANDLER,""factions"",[""OPF_F""]] call ALiVE_fnc_HashGet;" \n
                         "private _sidesEnemy = [_OPCOM_HANDLER,""sidesenemy"",[""EAST""]] call ALiVE_fnc_HashGet;" \n
                         "private _sidesFriendly = [_OPCOM_HANDLER,""sidesfriendly"",[""WEST""]] call ALiVE_fnc_HashGet;" \n
                         "private _controltype = [_OPCOM_HANDLER, ""controltype"",""invasion""] call ALiVE_fnc_HashGet;" \n
                         "private _simultanObjectives = [_OPCOM_HANDLER, ""simultanobjectives"",10] call ALiVE_fnc_HashGet;" \n
                         "private _reinforcementRatio = [_OPCOM_HANDLER, ""reinforcements"",0.9] call ALiVE_fnc_HashGet;" \n
                         "private _reconBuildingTypes = (ALiVE_militaryBuildingTypes + ALIVE_militaryHQBuildingTypes + ALIVE_civilianPopulationBuildingTypes + ALIVE_militaryParkingBuildingTypes + ALIVE_civilianHQBuildingTypes + ALIVE_civilianCommsBuildingTypes + ALIVE_civilianFuelBuildingTypes) apply {toLower _x};" \n
                         "" \n
                         "private _pause = false;" \n
                         "" \n
                         "private _OPCOM_DATA = [];" \n
                         "private _OPCOM_QUEUE = [];" \n
                         "private _targets = [];" \n
                         "private _cycleTime = 300;" \n
                         "private _timestamp = time;" \n
                         "private _lastanalyze = 0;" \n
                         "private _orderFailed = false;" \n
                         "private _orderConfirmationTimeout = 10;" \n
                         "private _nextOrderID = 0;" \n
                         "private _unconfirmedOrders = [];" \n
                         "private _colorside = ""ColorRed"";" \n
                         "private _reinforcementsInProgress = false;" \n
                         "" \n
                         "private _OPCOM_SKIP_OBJECTIVES = [];" \n
                         "" \n
                         "switch (_side) do {" \n
                         "    case (""WEST"") : {_colorside = ""ColorBlue""};" \n
                         "    case (""EAST"") : {_colorside = ""ColorRed""};" \n
                         "    case (""GUER"") : {_colorside = ""ColorGreen""};" \n
                         "};" \n
                         "" \n
                         "" \n
                         "" \n
                         "// debug ---------------------------------------" \n
                         "if(_debug) then {" \n
                         "    [ ""OPCOM INIT""] call ALIVE_fnc_dumpR;" \n
                         "    //[true] call ALIVE_fnc_timer;" \n
                         "};" \n
                         "// debug ---------------------------------------" \n
                         "" \n
                         "/*" \n
                         "//Mock targets for testing purposes" \n
                         "" \n
                         "// markers m_0 -  m_15" \n
                         "_objectives_unsorted = [];" \n
                         "for ""_i"" from 0 to 15 do {" \n
                         "	_objectives_unsorted pushback [(getmarkerpos format[""m_%1"",_i]),150,""civilian"",25];" \n
                         "};" \n
                         "" \n
                         "_objectives = [_objectives_unsorted,[],{([_OPCOM_HANDLER,""position""] call ALiVE_fnc_HashGet) distance (_x select 0)},""ASCEND""] call ALiVE_fnc_SortBy;" \n
                         "" \n
                         "//Create objectives for OPCOM and set it on the OPCOM Handler " \n
                         "//GetObjectivesByPriority" \n
                         "{" \n
                         "	_target = [nil, ""createhashobject""] call ALIVE_fnc_OPCOM;" \n
                         "" \n
                         "	_id = format[""OPCOM_objective_%1_%2"",_side,_foreachIndex]; [_target, ""objectiveID"",_id] call ALIVE_fnc_HashSet;" \n
                         "	_pos = _x select 0; [_target, ""center"",_pos] call ALIVE_fnc_HashSet;" \n
                         "	_size = _x select 1; [_target, ""size"",_size] call ALIVE_fnc_HashSet;" \n
                         "	_type = _x select 2; [_target, ""objectiveType"",_type] call ALIVE_fnc_HashSet;" \n
                         "	_priority = _x select 3; [_target, ""priority"",_priority] call ALIVE_fnc_HashSet;" \n
                         "	_opcom_state = ""unassigned""; [_target, ""opcom_state"",_opcom_state] call ALIVE_fnc_HashSet;" \n
                         "" \n
                         "	if  (_debug) then {" \n
                         "		_m = createMarkerLocal [_id, _pos];" \n
                         "		_m setMarkerShapeLocal ""RECTANGLE"";" \n
                         "		_m setMarkerSizeLocal [_size, _size];" \n
                         "		_m setMarkerTypeLocal ""hd_dot"";" \n
                         "		_m setMarkerColorLocal ""ColorWhite"";" \n
                         "		//_m setMarkerTextLocal format[""Objective Priority %1"",_foreachIndex];" \n
                         "	};" \n
                         "" \n
                         "	_objectives set [_forEachIndex, _target];" \n
                         " } foreach _objectives;" \n
                         "" \n
                         "_objectives = [_OPCOM_HANDLER,""objectives"",_objectives] call ALiVE_fnc_OPCOM;" \n
                         "*/" \n
                         "" \n
                         "// debug ---------------------------------------" \n
                         "if(_debug) then {" \n
                         "    [ ""OPCOM INIT COMPLETE ""] call ALIVE_fnc_dumpR;" \n
                         "    [ ""OPCOM Objectives: %1"",_objectives] call ALIVE_fnc_dump;" \n
                         "    //_objectives call ALIVE_fnc_inspectHash; // bugged??" \n
                         "    //[] call ALIVE_fnc_timer;" \n
                         "};" \n
                         "// debug ---------------------------------------" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "INIT_COMPLETE">*/
                                class INIT_COMPLETE
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="INITIALIZE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/"_OPCOM_FSM =  [_OPCOM_HANDLER,""OPCOM_FSM""] call ALiVE_fnc_HashGet;" \n
                                         "_TACOM_FSM =  [_OPCOM_HANDLER,""TACOM_FSM""] call ALiVE_fnc_HashGet;"/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isnil ""_OPCOM_FSM"") && !(isnil ""_TACOM_FSM"") && {_OPCOM_FSM > 0 && _TACOM_FSM > 0}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "ANALYZE">*/
                class ANALYZE
                {
                        name = "ANALYZE";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "_OPCOM_status = ""switch"";" \n
                         "_timestamp = time;" \n
                         "" \n
                         "private [""_target"",""_targetId"",""_obj"",""_attack"",""_defend"",""_reserve"",""_custom"",""_qrf"",""_recon"",""_oca"",""_operation"",""_priorities"",""_data_operation"",""_data_value"",""_targetsWithState"",""_OPCOM_ACTION"",""_targetOccupation"",""_analyze"",""_data""];" \n
                         "" \n
                         "_busy = true;" \n
                         "" \n
                         "private _recon = nil;" \n
                         "private _oca = nil;" \n
                         "private _target = nil;" \n
                         "private _analyze = nil;" \n
                         "private _attack = nil;" \n
                         "private _defend = nil;" \n
                         "private _reserve = nil;" \n
                         "private _custom = nil;" \n
                         "" \n
                         "private _skipObjective = false;" \n
                         "" \n
                         "_data_operation = nil;" \n
                         "_data_value = nil;" \n
                         "" \n
                         "if (count _OPCOM_QUEUE > 0) then {" \n
                         "    _OPCOM_ACTION = _OPCOM_QUEUE deleteat 0;" \n
                         "};" \n
                         "" \n
                         "_timeout = ((isnil ""_OPCOM_ACTION"") && {(time - _lastAnalyze) >= _cycleTime});" \n
                         "if (_timeout) then {_OPCOM_ACTION = [""analyze"",nil]};" \n
                         "" \n
                         "//start operating if data was received" \n
                         "if !(isnil ""_OPCOM_ACTION"") then {" \n
                         "    _DATA_OPERATION = _OPCOM_ACTION select 0;" \n
                         "    _DATA_VALUE = _OPCOM_ACTION select 1;" \n
                         "    _OPCOM_ACTION = nil;" \n
                         "" \n
                         "    //select operation type" \n
                         "    switch (_DATA_OPERATION) do {" \n
                         "        case (""init"") : {" \n
                         "            if (_debug) then {" \n
                         "                [_OPCOM_HANDLER,""OPCOM_monitor"",true] call AliVE_fnc_OPCOM;" \n
                         "            };" \n
                         "" \n
                         "            _OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                         "" \n
                         "            if(_debug) then { [""OPCOM initialized, %1!"",_DATA_VALUE] call ALIVE_fnc_dumpR; };" \n
                         "" \n
                         "            _busy = false;" \n
                         "        };" \n
                         "" \n
                         "        case (""analyze"") : {" \n
                         "            private[""_selectedState"",""_selectedObjective""];" \n
                         "" \n
                         "            //Check TACOMs Data value (starting attack if you pass nil to it, see below)" \n
                         "            if !(isnil ""_DATA_VALUE"") then {" \n
                         "                switch (_DATA_VALUE) do {" \n
                         "                    case (""no groups available"") : {};" \n
                         "                    case (""analysis""): {_analyze = ""analysis""};" \n
                         "                    default {};" \n
                         "                };" \n
                         "            };" \n
                         "" \n
                         "            //AnalyzeClusterOccupation" \n
                         "            _targetOccupation = [_OPCOM_HANDLER,""clusteroccupation"",[]] call ALiVE_fnc_HashGet;" \n
                         "            _targetOccupation params [""_friendlyObjectives"",""_enemyObjectives"",""_contestedObjectives"",""_timeLastAnalysis""];" \n
                         "            if (" \n
                         "                ( (_targetOccupation isnotequalto []) && {time - _timeLastAnalysis > _cycleTime} )" \n
                         "                ||" \n
                         "                { _targetOccupation isequalto [] }" \n
                         "            ) then {" \n
                         "                _analyze = ""analysis"";" \n
                         "            };" \n
                         "" \n
                         "            //Exit if analysis should happen" \n
                         "            if !(isnil ""_analyze"") exitwith {_busy = false};" \n
                         "" \n
                         "            //Exit if reeinforcements need to be requested" \n
                         "            if !(isnil ""_reinforce"") exitwith {_busy = false};" \n
                         "" \n
                         "            //Get objectives" \n
                         "            _obj = ([_OPCOM_HANDLER,""objectives"",[]] call AliVE_fnc_HashGet);" \n
                         "" \n
                         "            _un = [];" \n
                         "            _at = [];" \n
                         "            _def = [];" \n
                         "            _res = [];" \n
                         "            // Pending attack requests already consume a simultaneous-objective slot." \n
                         "            _active = {((_x select 1) isEqualTo ""attack"")} count _unconfirmedOrders;" \n
                         "" \n
                         "            {" \n
                         "                private _candidateObjective = _x;" \n
                         "                private _objectiveID = _x select 2 select 0;" \n
                         "                private _orderInFlight = (_unconfirmedOrders findIf {((_x select 2) isEqualRef _candidateObjective)}) >= 0;" \n
                         "" \n
                         "                if (!(_objectiveID in _OPCOM_SKIP_OBJECTIVES) && {!_orderInFlight}) then {" \n
                         "                    private [""_state""];" \n
                         "" \n
                         "                    _state = _x select 2 select 5;" \n
                         "" \n
                         "                    switch (_state) do {" \n
                         "                        case (""unassigned"") : {if (_un isEqualTo []) then {_un pushBack _x}};" \n
                         "                        case (""attack"") : {if (_at isEqualTo []) then {_at pushBack _x}};" \n
                         "                        case (""defend"") : {if (_def isEqualTo []) then {_def pushBack _x}};" \n
                         "                        case (""reserve"") : {if (_res isEqualTo []) then {_res pushBack _x}};" \n
                         "                    };" \n
                         "" \n
                         "                    if (_state isEqualTo ""attacking"") then {_active = _active + 1};" \n
                         "                };" \n
                         "            } foreach _obj;" \n
                         "" \n
                         "            // Unassigned objectives become attack orders, so they share this capacity." \n
                         "            private _attackCapacityAvailable = _active < _simultanObjectives;" \n
                         "" \n
                         "            //AnalyzeResults - prepare orders" \n
                         "" \n
                         "                switch (_controltype) do {" \n
                         "                    case (""invasion"") : {" \n
                         "" \n
                         "                        _priorities = [" \n
                         "                            [(count _res > 0),""reserve""]," \n
                         "                            [(count _un > 0) && _attackCapacityAvailable,""unassigned""]," \n
                         "                            [(count _at > 0) && _attackCapacityAvailable,""attack""]," \n
                         "                            [(count _def > 0),""defend""]" \n
                         "                        ];" \n
                         "                    };" \n
                         "        " \n
                         "                    case (""occupation"") : {" \n
                         "                        _priorities = [" \n
                         "                            [(count _res > 0),""reserve""]," \n
                         "                            [(count _def > 0),""defend""]," \n
                         "                            [(count _at > 0) && _attackCapacityAvailable,""attack""]," \n
                         "                            [(count _un > 0) && _attackCapacityAvailable,""unassigned""]" \n
                         "                        ];" \n
                         "                    };" \n
                         "                };" \n
                         "" \n
                         "                {" \n
                         "                    if (_x select 0) exitwith {" \n
                         "                        _selectedState = (_x select 1);" \n
                         "                    };" \n
                         "                } foreach _priorities;" \n
                         "" \n
                         "            //Select orders and execute" \n
                         "            if !(isnil ""_selectedState"") then {" \n
                         "                _selectedObjective = switch (_selectedState) do {" \n
                         "                    case (""unassigned"") : {_un select 0};" \n
                         "                    case (""attack"") : {_at select 0};" \n
                         "                    case (""defend"") : {_def select 0};" \n
                         "                    case (""reserve"") : {_res select 0};" \n
                         "                };" \n
                         "" \n
                         "                private _selectionAllowed = true;" \n
                         "                if (_selectedState in [""attack"",""unassigned""]) then {" \n
                         "                    private _module = [_OPCOM_HANDLER,""module""] call ALiVE_fnc_HashGet;" \n
                         "                    _selectionAllowed = {((typeof _x) == ""EmptyDetector"") && {!(triggerActivated _x)}} count (synchronizedObjects _module) == 0;" \n
                         "                };" \n
                         "" \n
                         "                if (_selectionAllowed) then {" \n
                         "                    _operation = switch (_selectedState) do {" \n
                         "                        case (""unassigned"") : {""attack""};" \n
                         "                        case (""attack"") : {""attack""};" \n
                         "                        case (""defend"") : {""defend""};" \n
                         "                        case (""reserve"") : {""reserve""};" \n
                         "                    };" \n
                         "" \n
                         "                    [_selectedObjective,""opcom_orders"",_operation] call AliVE_fnc_HashSet;" \n
                         "" \n
                         "                    switch (_operation) do {" \n
                         "                        case (""attack"") : {" \n
                         "                            _attack = _selectedObjective;" \n
                         "                        };" \n
                         "                        case (""defend"") : {" \n
                         "                            _defend = _selectedObjective;" \n
                         "                        };" \n
                         "                        case (""reserve"") : {" \n
                         "                            _reserve = _selectedObjective;" \n
                         "                        };" \n
                         "                        //Custom" \n
                         "                    };" \n
                         "                    if(_debug) then { [""OPCOM orders TACOM to %1 target %2"",_operation,([_selectedObjective,""objectiveID""] call AliVE_fnc_HashGet)] call ALIVE_fnc_dumpR; };" \n
                         "                } else {" \n
                         "                    _busy = false;" \n
                         "                };" \n
                         "            } else {" \n
                         "                _busy = false;" \n
                         "            };" \n
                         "        };" \n
                         "" \n
                         "        case (""completed"") : {" \n
                         "            _DATA_VALUE params [[""_completedOperation"",""""],[""_completedObjective"",[]]];" \n
                         "            private _nextOperation = switch (_completedOperation) do {" \n
                         "                case (""recon"") : {""attack""};" \n
                         "                case (""capture"") : {""reserve""};" \n
                         "                case (""defend"") : {""defend""};" \n
                         "                default {""""};" \n
                         "            };" \n
                         "            private _followUpInFlight = (_unconfirmedOrders findIf {((_x select 2) isEqualRef _completedObjective)}) >= 0;" \n
                         "            if (" \n
                         "                _nextOperation isEqualTo """"" \n
                         "                || {_completedObjective isEqualTo []}" \n
                         "                || {_followUpInFlight}" \n
                         "                || {[_completedObjective,""deleted"",false] call ALiVE_fnc_HashGet}" \n
                         "            ) exitwith {_busy = false};" \n
                         "" \n
                         "            [_completedObjective,""opcom_orders"",_nextOperation] call ALiVE_fnc_HashSet;" \n
                         "            switch (_nextOperation) do {" \n
                         "                case (""attack"") : {_attack = _completedObjective};" \n
                         "                case (""defend"") : {_defend = _completedObjective};" \n
                         "                case (""reserve"") : {_reserve = _completedObjective};" \n
                         "            };" \n
                         "        };" \n
                         "" \n
                         "        case (""expire_order"") : {" \n
                         "            private _orderID = _DATA_VALUE;" \n
                         "            private _unconfirmedOrderIndex = _unconfirmedOrders findIf {((_x select 0) isEqualTo _orderID)};" \n
                         "            if (_unconfirmedOrderIndex >= 0) then {" \n
                         "                private _unconfirmedOrder = _unconfirmedOrders select _unconfirmedOrderIndex;" \n
                         "                if (time >= (_unconfirmedOrder select 3)) then {" \n
                         "                    if (_debug) then {" \n
                         "                        [""OPCOM %1 expired unconfirmed TACOM order %2 for objective %3"",_side,_orderID,[(_unconfirmedOrder select 2),""objectiveID"",""unknown""] call ALiVE_fnc_HashGet] call ALiVE_fnc_DumpR;" \n
                         "                    };" \n
                         "                    _unconfirmedOrders deleteAt _unconfirmedOrderIndex;" \n
                         "                    _OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                         "                };" \n
                         "            };" \n
                         "            _busy = false;" \n
                         "        };" \n
                         "" \n
                         "        //Handle TACOM confirmation by state" \n
                         "        case (""confirmed"") : {" \n
                         "            if !(_DATA_VALUE isEqualType [] && {(count _DATA_VALUE) isEqualTo 4}) exitwith {" \n
                         "                if (_debug) then {[""OPCOM %1 ignored malformed TACOM confirmation"",_side] call ALiVE_fnc_DumpR};" \n
                         "                _busy = false;" \n
                         "            };" \n
                         "            _confirmed = _DATA_VALUE select 0;" \n
                         "            _information = _DATA_VALUE select 1;" \n
                         "            private _orderID = _DATA_VALUE select 2;" \n
                         "            private _confirmedAt = _DATA_VALUE select 3;" \n
                         "            if !(" \n
                         "                _confirmed isEqualType true" \n
                         "                && {_information isEqualType []}" \n
                         "                && {(count _information) >= 2}" \n
                         "                && {_orderID isEqualType 0}" \n
                         "                && {_orderID > 0}" \n
                         "                && {_confirmedAt isEqualType 0}" \n
                         "                && {(_information select 0) isEqualType []}" \n
                         "            ) exitwith {" \n
                         "                if (_debug) then {[""OPCOM %1 ignored malformed TACOM confirmation"",_side] call ALiVE_fnc_DumpR};" \n
                         "                _busy = false;" \n
                         "            };" \n
                         "" \n
                         "            _target = _information select 0;" \n
                         "            _return = _information select 1;" \n
                         "" \n
                         "            private _unconfirmedOrderIndex = _unconfirmedOrders findIf {" \n
                         "                ((_x select 0) isEqualTo _orderID) && {((_x select 2) isEqualRef _target)}" \n
                         "            };" \n
                         "            if (_unconfirmedOrderIndex < 0) exitwith {" \n
                         "                if (_debug) then {[""OPCOM %1 ignored stale confirmation for order %2, objective %3"",_side,_orderID,[_target,""objectiveID"",""unknown""] call ALiVE_fnc_HashGet] call ALiVE_fnc_DumpR};" \n
                         "                _busy = false;" \n
                         "            };" \n
                         "            private _unconfirmedOrder = _unconfirmedOrders select _unconfirmedOrderIndex;" \n
                         "            if (_confirmedAt >= (_unconfirmedOrder select 3)) exitwith {" \n
                         "                if (_debug) then {[""OPCOM %1 ignored late confirmation for expired order %2"",_side,_orderID] call ALiVE_fnc_DumpR};" \n
                         "                _unconfirmedOrders deleteAt _unconfirmedOrderIndex;" \n
                         "                _OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                         "                _busy = false;" \n
                         "            };" \n
                         "            _unconfirmedOrders deleteAt _unconfirmedOrderIndex;" \n
                         "" \n
                         "            if ([_target,""deleted"",false] call ALiVE_fnc_HashGet) exitwith {" \n
                         "                _OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                         "                _busy = false;" \n
                         "            };" \n
                         "" \n
                         "            _faction = selectRandom _factions;" \n
                         "            // Every enemy side is asked about at once below. Picking one at random lost every request that drew a side with no units on the map." \n
                         "" \n
                         "            _operation = _unconfirmedOrder select 1;" \n
                         "            _pos = [_target,""center""] call AliVE_fnc_HashGet;" \n
                         "            _targetId = [_target,""objectiveID""] call AliVE_fnc_HashGet;" \n
                         "" \n
                         "            if (_confirmed) then {" \n
                         "                switch (_operation) do {" \n
                         "                    case (""attack"") : {" \n
                         "                        [_target,""opcom_state"",""attacking""] call AliVE_fnc_HashSet;" \n
                         "                        if (_debug) then {format [""ALiVE_OPCOM_%1"",[_target,""objectiveID""] call ALiVE_fnc_HashGet] setMarkerColor ""ColorRed""};" \n
                         "" \n
                         "                        if ([_side,[""attacking""]] call ALIVE_fnc_OPCOMgetHighestPrioObjective == _targetId) then {" \n
                         "                            // Match the radius the capture task verifies with, see fnc_taskCaptureObjective.sqf." \n
                         "                            _targets = [_pos, (([_target,""size"",150] call AliVE_fnc_HashGet) min 500) max 200, [_sidesEnemy,""entity""],true] call ALIVE_fnc_getNearProfiles;" \n
                         "                            if (!isNil ""ALiVE_c2istar_taskDiag"" && {ALiVE_c2istar_taskDiag}) then {[""[OPCOM REQ] obj=%1 radius=%2 sides=%3 targets=%4"", _targetId, ((([_target,""size"",150] call AliVE_fnc_HashGet) min 500) max 200), _sidesEnemy, count _targets] call ALiVE_fnc_dump}; // DIAG-STRIP (order rate measurement)" \n
                         "                            [_side,_faction,""CaptureObjective"",_targets,""OPCOM"",true,_targetId] call ALiVE_fnc_taskRequest;" \n
                         "                        };" \n
                         "" \n
                         "                        //Assist TACOM by sending air recon after TACOMs attack confirmation" \n
                         "                        _OPCOM_QUEUE pushBack [""RECON"",[[_target,""objectiveID"",""""] call AliVE_fnc_HashGet]];" \n
                         "                    };" \n
                         "                    case (""defend"") : {" \n
                         "                        [_target,""opcom_state"",""defending""] call AliVE_fnc_HashSet;" \n
                         "                        if (_debug) then {format [""ALiVE_OPCOM_%1"",[_target,""objectiveID""] call ALiVE_fnc_HashGet] setMarkerColor ""ColorBlue""};" \n
                         "" \n
                         "                        //Trigger new OPCOM analysis after TACOM confirmation including TACOMs answer" \n
                         "                        _OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                         "                    };" \n
                         "                    case (""reserve"") : {" \n
                         "                        [_target,""opcom_state"",""reserving""] call AliVE_fnc_HashSet;" \n
                         "                        if (_debug) then {format [""ALiVE_OPCOM_%1"",[_target,""objectiveID""] call ALiVE_fnc_HashGet] setMarkerColor ""ColorGreen""};" \n
                         "" \n
                         "                        //Trigger new OPCOM analysis after TACOM confirmation including TACOMs answer" \n
                         "                        _OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                         "                    };" \n
                         "                    default {" \n
                         "                        //Trigger new OPCOM analysis after TACOM confirmation including TACOMs answer" \n
                         "                        _OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                         "                    };" \n
                         "                };" \n
                         "				" \n
                         "                private _opcomID = [_OPCOM_HANDLER,""opcomID""] call ALiVE_fnc_hashGet;" \n
                         "                private _event = ['OPCOM_ORDER_CONFIRMED', [_opcomID, _target,_operation, _side, _factions], ""OPCOM""] call ALIVE_fnc_event;" \n
                         "                [ALIVE_eventLog, ""addEvent"",_event] call ALIVE_fnc_eventLog;" \n
                         "" \n
                         "                if(_debug) then { [""TACOM message received: %1 %2! Details: %3!"",([_target,""opcom_state""] call AliVE_fnc_HashGet),([_target,""objectiveID""] call AliVE_fnc_HashGet),_return] call ALIVE_fnc_dumpR; };" \n
                         "" \n
                         "            }  else {" \n
                         "                _OPCOM_SKIP_OBJECTIVES pushBack ([_target, ""objectiveID""] call AliVE_fnc_HashGet);" \n
                         "                _OPCOM_QUEUE pushBack [""analyze"", nil];" \n
                         "                _skipObjective = true;" \n
                         "" \n
                         "                [_target,""opcom_orders"",""none""] call ALiVE_fnc_HashSet;" \n
                         "" \n
                         "                if(_debug) then {" \n
                         "                    [""TACOM message received: %1"", _return] call ALIVE_fnc_dumpR;" \n
                         "                    [""OPCOM skipping objective %1 for this cycle"", [_target, ""objectiveID""] call AliVE_fnc_HashGet] call ALIVE_fnc_dumpR;" \n
                         "                };" \n
                         "" \n
                         "            };" \n
                         "            _busy = false;" \n
                         "        };" \n
                         "" \n
                         "        case (""QRF"") : {" \n
                         "            _target = _DATA_VALUE select 0;" \n
                         "" \n
                         "             if(_debug) then { [""OPCOM retrieved request for QRF on %1!"",_target] call ALIVE_fnc_dumpR; };" \n
                         "" \n
                         "            _qrf = [""air"",_target];" \n
                         "        };" \n
                         "" \n
                         "        case (""RECON"") : {" \n
                         "            _target = _DATA_VALUE select 0;" \n
                         "" \n
                         "             if(_debug) then { [""OPCOM retrieved request for RECON on %1!"",_target] call ALIVE_fnc_dumpR; };" \n
                         "" \n
                         "            _recon = [""air"",_target];" \n
                         "        };" \n
                         "        " \n
                         "        case (""OCA"") : {" \n
                         "            _target = _DATA_VALUE select 0;" \n
                         "" \n
                         "             if(_debug) then { [""OPCOM retrieved request for OCA  on %1!"",_target] call ALIVE_fnc_dumpR; };" \n
                         "" \n
                         "            _oca = [""air"",_target];" \n
                         "        };" \n
                         "        " \n
                         "        case (""custom"") : {_custom = _DATA_VALUE};" \n
                         "        " \n
                         "        default {};" \n
                         "    };" \n
                         "" \n
                         "};" \n
                         "" \n
                         "_lastAnalyze = time;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {


                                /*%FSM<LINK "DEFEND_condition">*/
                                class DEFEND_condition
                                {
                                        itemno = 7;
                                        priority = 4.000000;
                                        to="ORDER_TACOM";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isnil ""_defend"") || !(isnil ""_attack"") || !(isnil ""_reserve"") || !(isnil ""_custom"");"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/


                                /*%FSM<LINK "OPCOM_FEEDER">*/
                                class OPCOM_FEEDER
                                {
                                        itemno = 3;
                                        priority = 1.000000;
                                        to="ANALYZE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time - _lastAnalyze > _cycleTime"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/

                                /*%FSM<LINK "ANALYZE_Conditio">*/
                                class ANALYZE_Conditio
                                {
                                        itemno = 22;
                                        priority = 0.000000;
                                        to="PERFORM_CLEANUP";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isnil ""_analyze"");"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "REEINFORCE_Condi">*/
                                class REEINFORCE_Condi
                                {
                                        itemno = 30;
                                        priority = 0.000000;
                                        to="REQUEST_REEINFOR";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isnil ""_reinforce"") && !_reinforcementsInProgress;"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "QRF_Conditions">*/
                                class QRF_Conditions
                                {
                                        itemno = 35;
                                        priority = 0.000000;
                                        to="REQUEST_QRF";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isnil ""_qrf"");"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "RECON_Conditions">*/
                                class RECON_Conditions
                                {
                                        itemno = 37;
                                        priority = 0.000000;
                                        to="REQUEST_RECON";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isnil ""_recon"");"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "OCA_Conditions">*/
                                class OCA_Conditions
                                {
                                        itemno = 39;
                                        priority = 0.000000;
                                        to="REQUEST_OCA";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isnil ""_oca"");"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/



                                /*%FSM<LINK "Skip_Objective">*/
                                class Skip_Objective
                                {
                                        itemno = 41;
                                        priority = 0.000000;
                                        to="NOT_BUSY_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_skipObjective"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/






                                /*%FSM<LINK "EXIT">*/
                                class EXIT
                                {
                                        itemno = 28;
                                        priority = 99.000000;
                                        to="END";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_exitFSM"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/

                                /*%FSM<LINK "OPCOM_RECEIVER">*/
                                class OPCOM_RECEIVER
                                {
                                        itemno = 9;
                                        priority = 1.000000;
                                        to="COLLECT_TO_QUEUE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/"_failsafe = false; _failsafe = (time - _timestamp) > _cycleTime;" \n
                                         ""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_OPCOM_status = ""waiting for data""; " \n
                                         "" \n
                                         "//See PreCondition and Action for _failsafe and _pause" \n
                                         "((_OPCOM_DATA isnotequalto []) || {count _OPCOM_QUEUE > 0} || {_orderFailed} || {_failsafe}) && {!_pause};"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"if (_orderFailed || {_failsafe}) then {" \n
                                         "	_orderFailed = false;" \n
                                         "	_failsafe = false;" \n
                                         "	_OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                                         "};" \n
                                         "" \n
                                         "_busy = false;"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "ORDER_TACOM">*/
                class ORDER_TACOM
                {
                        name = "ORDER_TACOM";
                        itemno = 11;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "_OPCOM_status = ""order"";" \n
                         "_timestamp = time;" \n
                         "" \n
                         "_operation = nil;" \n
                         "" \n
                         "//prepare transmission" \n
                         "if !(isnil ""_attack"") then {_operation = ""attack""};" \n
                         "if !(isnil ""_defend"") then {_operation = ""defend""};" \n
                         "if !(isnil ""_reserve"") then {_operation = ""reserve""};" \n
                         "if !(isnil ""_custom"") then {_operation = ""custom""};" \n
                         "" \n
                         "// Register the request and return immediately; confirmations are ordinary FIFO work." \n
                         "private _orderTarget = switch (_operation) do {" \n
                         "    case (""attack"") : {_attack};" \n
                         "    case (""defend"") : {_defend};" \n
                         "    case (""reserve"") : {_reserve};" \n
                         "    default {nil};" \n
                         "};" \n
                         "if !(isNil ""_orderTarget"") then {" \n
                         "    _nextOrderID = _nextOrderID + 1;" \n
                         "    private _orderID = _nextOrderID;" \n
                         "    private _orderDeadline = time + _orderConfirmationTimeout;" \n
                         "    _unconfirmedOrders pushBack [_orderID,_operation,_orderTarget,_orderDeadline];" \n
                         "    private _queue = _TACOM_FSM getFSMVariable [""_TACOM_QUEUE"",[]];" \n
                         "    _queue pushBack [""analyze_order"",[_orderID,_operation,_orderTarget,_orderDeadline]];" \n
                         "    _TACOM_FSM setFSMVariable [""_TACOM_QUEUE"",_queue];" \n
                         "    _OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                         "    [{" \n
                         "        params [""_opcomFSM"",""_orderID""];" \n
                         "        if !(_opcomFSM getFSMVariable [""_exitFSM"",true]) then {" \n
                         "            private _orders = _opcomFSM getFSMVariable [""_unconfirmedOrders"",[]];" \n
                         "            if ((_orders findIf {((_x select 0) isEqualTo _orderID)}) >= 0) then {" \n
                         "                private _opcomQueue = _opcomFSM getFSMVariable [""_OPCOM_QUEUE"",[]];" \n
                         "                _opcomQueue pushBack [""expire_order"",_orderID];" \n
                         "                _opcomFSM setFSMVariable [""_OPCOM_QUEUE"",_opcomQueue];" \n
                         "            };" \n
                         "        };" \n
                         "    },[_OPCOM_FSM,_orderID],_orderConfirmationTimeout] call CBA_fnc_waitAndExecute;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {

                                /*%FSM<LINK "TACOM_CONFIRM">*/
                                class TACOM_CONFIRM
                                {
                                        itemno = 12;
                                        priority = 0.000000;
                                        to="NOT_BUSY_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "INITIALIZE">*/
                class INITIALIZE
                {
                        name = "INITIALIZE";
                        itemno = 17;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "_OPCOM_status = ""Init"";" \n
                         "" \n
                         "_OPCOM_QUEUE pushBack [""init"",true];" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {








                                /*%FSM<LINK "OPCOM_RECEIVER">*/
                                class OPCOM_RECEIVER
                                {
                                        itemno = 9;
                                        priority = 1.000000;
                                        to="COLLECT_TO_QUEUE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/"_failsafe = false; _failsafe = (time - _timestamp) > _cycleTime;" \n
                                         ""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_OPCOM_status = ""waiting for data""; " \n
                                         "" \n
                                         "//See PreCondition and Action for _failsafe and _pause" \n
                                         "((_OPCOM_DATA isnotequalto []) || {count _OPCOM_QUEUE > 0} || {_orderFailed} || {_failsafe}) && {!_pause};"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"if (_orderFailed || {_failsafe}) then {" \n
                                         "	_orderFailed = false;" \n
                                         "	_failsafe = false;" \n
                                         "	_OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                                         "};" \n
                                         "" \n
                                         "_busy = false;"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/

                /*%FSM<STATE "NOT_BUSY_1">*/
                class NOT_BUSY_1
                {
                        name = "NOT_BUSY_1";
                        itemno = 19;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "_OPCOM_status = ""reset"";" \n
                         "_timestamp = time;" \n
                         "" \n
                         "_busy = false;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {










                                /*%FSM<LINK "EXIT">*/
                                class EXIT
                                {
                                        itemno = 28;
                                        priority = 99.000000;
                                        to="END";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_exitFSM"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/

                                /*%FSM<LINK "OPCOM_RECEIVER">*/
                                class OPCOM_RECEIVER
                                {
                                        itemno = 9;
                                        priority = 1.000000;
                                        to="COLLECT_TO_QUEUE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/"_failsafe = false; _failsafe = (time - _timestamp) > _cycleTime;" \n
                                         ""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_OPCOM_status = ""waiting for data""; " \n
                                         "" \n
                                         "//See PreCondition and Action for _failsafe and _pause" \n
                                         "((_OPCOM_DATA isnotequalto []) || {count _OPCOM_QUEUE > 0} || {_orderFailed} || {_failsafe}) && {!_pause};"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"if (_orderFailed || {_failsafe}) then {" \n
                                         "	_orderFailed = false;" \n
                                         "	_failsafe = false;" \n
                                         "	_OPCOM_QUEUE pushBack [""analyze"",nil];" \n
                                         "};" \n
                                         "" \n
                                         "_busy = false;"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
