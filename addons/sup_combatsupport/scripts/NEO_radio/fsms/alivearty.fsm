                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(_grp getVariable [""ALiVE_CS_mortarMove"", """"] == """" && {{ alive _x } count _units < 1})" \n
                                         "||" \n
                                         "{ alive _x } count units _grp < 1" \n
