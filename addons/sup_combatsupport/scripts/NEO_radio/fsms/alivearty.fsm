                                /*%FSM<LINK "Move_out_">*/
                                class Move_out_
                                {
                                        itemno = 34;
                                        priority = 1.000000;
                                        to="__10";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!isNil { _battery getVariable ""NEO_radioArtyMove"" }" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"_battery setVariable [""NEO_radioArtyUnitStatus"", ""MOVE"", true];" \n
                                         "_battery setVariable [""NEO_radioArtyMove"", nil, true];" \n
                                         "" \n
                                         "// the band the battery fires this round in, as the fire check measured it. From too far it stops at 9/10" \n
                                         "// of its reach, or a tenth closer if the check refused a target inside the reach, and the reach is taken" \n
                                         "// for the ground it would stand on: a target h metres higher is reached out to R * sqrt(1 - 2h/R), so a" \n
                                         "// few passes settle the stop. It never stops inside half as far again as the minimum, which is where a" \n
                                         "// target too close sends it. The weapon's own range, used before, can be far from the round's (the Mk6" \n
                                         "// mortar's says 500 m against a shell that lands out to about 4080 m), and a target between that range's" \n
                                         "// ends set no distance at all, so the battery was sent to the target itself." \n
                                         "_firingDistance = [_units, _ordnance, _class] call NEO_fnc_artyUnitFiringDistance;" \n
                                         "_dirMove = (_target getDir _leader);" \n
                                         "private _distTarget = _leader distance2D _target;" \n
                                         "private _reach = _firingDistance select 1;" \n
                                         "private _ground = getTerrainHeightASL _target;" \n
                                         "_radiusMove = 0.9 * (_distTarget min _reach);" \n
                                         "for ""_i"" from 1 to 3 do {" \n
                                         "    private _dh = _ground - getTerrainHeightASL (_target getPos [_radiusMove, _dirMove]);" \n
                                         "    _radiusMove = _radiusMove min (0.9 * _reach * sqrt (0 max (1 - 2 * _dh / _reach)));" \n
                                         "};" \n
                                         "_radiusMove = _radiusMove max (1.5 * (_firingDistance select 0));" \n
                                         "// and on dry ground with room round it: the search below only takes dry spots but falls back to this point" \n
                                         "// when it finds none, and each man goes to a point 50 m round the stop, so a stop at sea or by the water's" \n
                                         "// edge sends men into the sea, where the team stops and never sets up. A stop with water within 60 m is" \n
                                         "// pulled in along the line until it has none." \n
                                         "private _wet = { private _p = _target getPos [_this, _dirMove]; surfaceIsWater _p || {({ surfaceIsWater (_p getPos [60, _x]) } count [0, 90, 180, 270]) > 0} };" \n
                                         "while { _radiusMove > 1.5 * (_firingDistance select 0) && {_radiusMove call _wet} } do { _radiusMove = _radiusMove - 25 };" \n
                                         "_posMove = (_target getPos [_radiusMove, _dirMove]);" \n
                                         "_isFlat = _posMove isflatempty [10,0,1,10,0,false,objNull];" \n
                                         "_tries = 0;" \n
                                         "" \n
                                         "while { count _isFlat < 2 && _tries < 360 } do" \n
                                         "{" \n
                                         "    _tries = _tries + 1;" \n
                                         "    _dirMove = _dirMove + 1;" \n
                                         "    _posMove = (_target getPos [_radiusMove, _dirMove]);" \n
                                         "    _isFlat = _posMove isflatempty [50,0,0.9,50,0,false,objNull];" \n
                                         "};" \n
                                         "" \n
                                         "if (count _isFlat < 2) then" \n
                                         "{" \n
                                         "    _isFlat = (_target getPos [_radiusMove, (_target getDir _leader)]);" \n
                                         "};" \n
                                         "" \n
                                         "_grp setVariable [""NEO_radioArtyNotInBase"", _isFlat];" \n
                                         "" \n
                                         "// IF its a mortar team moving, get them to disassemble and pack up" \n
                                         "if ((typeOf (vehicle _battery)) in [""O_Mortar_01_F"", ""B_Mortar_01_F"",""I_Mortar_01_F""]) then {" \n
                                         "" \n
                                         "    _grp setVariable [""mortar"", true];" \n
                                         "" \n
                                         "diag_log ""Battery is mortar, waiting for team to pack up mortars"";" \n
                                         "" \n
                                         "    // Taking a tube apart deletes it and runs for up to a minute and a half in a script of its own, and this" \n
                                         "    // action can't wait (its old loop gave up at once and sent the team off mid-pack), so a script waits for" \n
                                         "    // every tube to be packed and sends the team then. ALiVE_CS_mortarMove tells the dead checks the tubes" \n
                                         "    // are gone on purpose until the new ones are counted, and keeps the arrival check off until they leave." \n
                                         "    // Called back to base on the way, the team is already packed: it's only turned round, or, still" \n
                                         "    // packing, the script sends it to the new place, read when it goes. Each tube needs a man on foot to" \n
                                         "    // carry its second half, picked by the pack's own rule (on foot, not the leader, not already carrying)," \n
                                         "    // so a team short of those stays. A tube whose gunner is gone can't be carried or fired: it's removed." \n
                                         "    private _tubesUp = (_grp getVariable [""supportWeaponArray"",[]]) select { alive _x && {alive gunner _x} };" \n
                                         "    private _carriers = (units _grp) select { alive _x && {vehicle _x == _x} && {_x != leader _grp} && {!(_x getVariable [""packAssistant"", false])} };" \n
                                         "    _grp setVariable [""ALiVE_CS_mortarDest"", _isFlat];" \n
                                         "    switch (_grp getVariable [""ALiVE_CS_mortarMove"", """"]) do {" \n
                                         "        case """": {" \n
                                         "            if (count _carriers < count _tubesUp) then {" \n
                                         "                // the battery doesn't go: the move is called off as a recall would, and the player is told" \n
                                         "                // that instead of the usual ""moving in range"" (ALiVE_CS_refused silences it)" \n
                                         "                _grp setVariable [""NEO_radioArtyNotInBase"", nil];" \n
                                         "                _grp setVariable [""ALiVE_CS_refused"", true];" \n
                                         "                _battery setVariable [""NEO_radioArtyGoToBase"", true, true];" \n
                                         "                [(leader _grp), _callsign, _callsignPlayer] spawn {" \n
                                         "                    sleep 6;" \n
                                         "                    private _msg = format [""%1, %2 hasn't the men left to carry its mortars, staying put. Out."", _this select 2, _this select 1];" \n
                                         "                    [[_this select 0, _msg, ""side""],""NEO_fnc_messageBroadcast"",true,false] spawn BIS_fnc_MP;" \n
                                         "                };" \n
                                         "            } else {" \n
                                         "                _grp setVariable [""ALiVE_CS_mortarMove"", ""packing""];" \n
                                         "                _grp setVariable [""ALiVE_CS_packedTubes"", []];" \n
                                         "                {" \n
                                         "                    if (_x in _tubesUp) then { [_grp, _x] call ALiVE_fnc_packMortar } else { deleteVehicle _x };" \n
                                         "                } foreach (_grp getVariable [""supportWeaponArray"",[]]);" \n
                                         "" \n
                                         "                _grp spawn {" \n
                                         "                    private _grp = _this;" \n
                                         "                    private _t0 = time;" \n
                                         "                    waitUntil {" \n
                                         "                        sleep 1;" \n
                                         "                        private _recs = _grp getVariable [""ALiVE_CS_packedTubes"", []];" \n
                                         "                        ({ _x select 4 } count _recs) == count _recs || {time - _t0 > 120}" \n
                                         "                    };" \n
                                         "                    diag_log ""Mortar team have packed up mortars and are moving"";" \n
                                         "                    private _dest = _grp getVariable [""ALiVE_CS_mortarDest"", getPos (leader _grp)];" \n
                                         "                    {" \n
                                         "                        _x enableAI ""MOVE""; _x enableAI ""ANIM"";" \n
                                         "                        [_x, (_dest getPos [50, (random 360)])] call ALiVE_fnc_doMoveRemote;" \n
                                         "                    } forEach (units _grp);" \n
                                         "                    sleep 5;" \n
                                         "                    _grp setVariable [""ALiVE_CS_mortarMove"", ""moving""];" \n
                                         "                };" \n
                                         "            };" \n
                                         "        };" \n
                                         "        case ""moving"": {" \n
                                         "            {" \n
                                         "                [_x, (_isFlat getPos [50, (random 360)])] call ALiVE_fnc_doMoveRemote;" \n
                                         "            } forEach (units _grp);" \n
                                         "        };" \n
                                         "    };" \n
                                         "" \n
                                         "} else {" \n
                                         "    _grp setVariable [""mortar"", false];" \n
                                         "    {" \n
                                         "        [_x, (_isFlat getPos [50, (random 360)])] call ALiVE_fnc_doMoveRemote;" \n
                                         "    } forEach _units;" \n
                                         "" \n
                                         "};" \n
                                         "" \n
                                         "[(leader _grp), _callsign, _callsignPlayer, _grp] spawn" \n
                                         "{" \n
                                         "    private ""_msg"";" \n
                                         "    _msg = format[""Copy that %1, %2 moving in range of target, stand by. Out."", _this select 2, _this select 1];" \n
                                         "    sleep 5;" \n
                                         "    if ((_this select 3) getVariable [""ALiVE_CS_refused"", false]) exitWith { (_this select 3) setVariable [""ALiVE_CS_refused"", nil] };" \n
                                         "    [[_this select 0, _msg, ""side""],""NEO_fnc_messageBroadcast"",true,false] spawn BIS_fnc_MP;" \n
                                         "};" \n
                                         ""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
