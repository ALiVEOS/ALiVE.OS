                                         "    _msg = format[""Copy that %1, %2 aborting fire mission. Out."", _this select 1, _this select 2];" \n
                                         "    sleep 5;" \n
                                         "    [[_this select 0,_msg, ""side""],""NEO_fnc_messageBroadcast"",true,false] spawn BIS_fnc_MP;" \n
                                         "};" \n
