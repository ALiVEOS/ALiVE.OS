                                        condition=/*%FSM<CONDITION""">*/"count (_grp getVariable [""supportWeaponArray"",[]]) == _grp getVariable [""supportWeaponCount"",3]" \n
                                         "|| {_grp getVariable [""ALiVE_CS_mortarMove"", """"] == ""unpacking"" && {time - (_grp getVariable [""ALiVE_CS_unpackStart"", time]) > 150}}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"diag_log ""Mortar team have unpacked mortars and are ready"";" \n
                                         "_units = _grp getVariable [""supportWeaponArray"",[]];" \n
                                         "_grp setVariable [""supportWeaponCount"", count _units];" \n
                                         "// the resupply watch and the tablet's battery list still pointed at the tubes taken apart: the watch" \n
