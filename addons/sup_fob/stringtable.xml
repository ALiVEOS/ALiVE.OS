            </Key>
            <Key ID="STR_ALIVE_FOB_DISCOVERY_RADIUS">
                <English>Discovery Radius</English>
            </Key>
            <Key ID="STR_ALIVE_FOB_DISCOVERY_RADIUS_COMMENT">
                <English>With Contact targeting, enemy men inside this many metres of a FOB give it away to their side's commanders.</English>
