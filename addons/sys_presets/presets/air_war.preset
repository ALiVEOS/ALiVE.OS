["ALIVEPRESET",2,["Air war: NATO and CSAT fight for the sky","Two air commanders fight over the sea north of Altis. NATO flies from the main airport where you drop the preset and stocks it with its own jets. CSAT has no airfield: it flies in from a point out at sea to the north-east. Each patrols its home airspace and FRONT_AIR between the two, and scrambles interceptors when the other side's aircraft come into its airspace. Place yourself and your players as NATO pilots at the main airport. This one needs Altis, because it relies on the main airport and the open sea north of it.","ALiVE","Altis","3.2.0.2604133","2026-09-26",[14700,16350]],[["ALiVE_require",[],[-40,-30]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-20,-30]],["ALiVE_mil_ato",[["ALiVE_mil_ato_faction","BLU_F"],["ALiVE_mil_ato_airspace","NATO_AIR,FRONT_AIR"],["ALiVE_mil_ato_placeAir","true"]],[0,0]],["ALiVE_mil_ato",[["ALiVE_mil_ato_faction","OPF_F"],["ALiVE_mil_ato_airspace","CSAT_AIR,FRONT_AIR"],["ALiVE_mil_ato_placeAir","true"],["ALiVE_mil_ato_ingressMarker","CSAT_AIR"],["ALiVE_mil_ato_virtualSlots","8"]],[8300,11150]]],[],[],[],[["NATO_AIR","",1,[0,0],[3000,3000],0,"Solid","ColorWEST",0.35,""],["FRONT_AIR","",1,[3050,6650],[2750,2750],0,"Solid","ColorOrange",0.35,""],["CSAT_AIR","",1,[8300,11150],[3000,3000],0,"Solid","ColorEAST",0.35,""]]]