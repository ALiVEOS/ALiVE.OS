["ALIVEPRESET",2,["Combat support: CAS, transport and artillery on call","NATO attacks CSAT's ground in the middle of Stratis from the Stratis Air Base, where you drop the preset, and your players have support on call there: an AH-99 for close air support, a UH-80 for transport and a battery of 3 M4 Scorchers. Supplies and vehicles can be ordered by convoy, helicopter or airdrop, and reinforcement convoys come up from NATO's logistics HQ at Camp Tempest, 2 km south. Anyone carrying a radio or a laser designator can use the support menu. Place yourself and your players as NATO at the base. The support vehicles appear exactly where their modules sit, so on another map move those three modules to open, flat ground.","ALiVE","Stratis","3.2.0.2604133","2026-09-27",[2090,5610]],[["ALiVE_require",[],[-40,-30]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-20,-30]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","invasion"],["ALiVE_mil_opcom_factions","[""BLU_F""]"],["ALiVE_mil_opcom_simultanObjectives",3],["ALiVE_mil_opcom_taskProfileCountOverrides","[[""attack"",8]]"]],[35,-2032]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_factions","[""BLU_F""]"],["ALiVE_mil_placement_custom_size","150"],["ALiVE_mil_placement_custom_customInfantryCount","10"],["ALiVE_mil_placement_custom_customMotorisedCount","4"],["ALiVE_mil_placement_custom_customMechanisedCount","2"],["ALiVE_mil_placement_custom_customArmourCount","1"],["ALiVE_mil_placement_custom_createFieldHQ","true"]],[0,0]],["ALiVE_mil_logistics",[],[20,-30]],["ALiVE_sup_combatsupport",[["ALiVE_sup_combatsupport_combatsupport_item","LaserDesignators,Radios"],["ALiVE_sup_combatsupport_combatsupport_singleoperator","0"]],[-290,80]],["ALiVE_sup_cas",[["ALiVE_sup_cas_cas_logistics","1"]],[-310,50]],["ALiVE_SUP_TRANSPORT",[["ALiVE_sup_transport_transport_logistics","1"]],[-310,110]],["ALiVE_sup_artillery",[["ALiVE_sup_artillery_artillery_logistics","1"]],[-330,-170]],["ALiVE_SUP_PLAYER_RESUPPLY",[["ALiVE_sup_player_resupply_pr_item","LaserDesignators,Radios"]],[40,-30]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""OPF_F""]"]],[2410,-610]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","ENEMY_AREA"],["ALiVE_mil_placement_faction","OPF_F"],["ALiVE_mil_placement_size","100"]],[2430,-610]]],[[2,3],[2,11],[10,11],[4,2],[6,5],[7,5],[8,5]],[],[],[["ENEMY_AREA","",1,[2410,-610],[1000,1100],0,"Solid","ColorEAST",0.5,""]]]