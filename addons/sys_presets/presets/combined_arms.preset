["ALIVEPRESET",2,["Combined arms assault: guns, armour and infantry","NATO attacks CSAT-held ground the way a real force would, with everything arriving at once. NATO's commander, set to Invasion, starts from a forward base where you drop the preset, with infantry, trucks, IFVs, tanks and a battery of guns. Its attacks arrive together, and it calls its guns down on an objective's defenders before it sends the assault in. CSAT's commander, set to Occupation, holds the military objectives inside the ENEMY_AREA marker with its own guns, answers back, and sends patrols out between its objectives. Place yourself and your players as NATO at the base. The area comes with the preset, so it works on any map: move it over a base or airfield to choose what is being fought for.","ALiVE","Altis","3.2.0.2604133","2026-10-18",[13000,13500]],[["ALiVE_require",[],[-16,-12]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-8,-12]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","invasion"],["ALiVE_mil_opcom_factions","[""BLU_F""]"],["ALiVE_mil_opcom_arriveTogether","true"],["ALiVE_mil_opcom_prepFire","true"]],[0,-12]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_customInfantryCount","14"],["ALiVE_mil_placement_custom_customMotorisedCount","6"],["ALiVE_mil_placement_custom_customMechanisedCount","5"],["ALiVE_mil_placement_custom_customArmourCount","3"],["ALiVE_mil_placement_custom_customArtilleryCount","2"],["ALiVE_mil_placement_custom_createFieldHQ","true"]],[0,0]],["ALiVE_mil_artillery",[],[-24,-12]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""OPF_F""]"],["ALiVE_mil_opcom_securityPatrols","some"]],[0,3400]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","ENEMY_AREA"],["ALiVE_mil_placement_faction","OPF_F"],["ALiVE_mil_placement_size","100"],["ALiVE_mil_placement_placeArtillery","true"]],[8,3400]],["ALiVE_mil_artillery",[],[-8,3400]]],[[2,3],[2,6],[2,4],[5,6],[5,7]],[],[],[["ENEMY_AREA","",0,[0,2700],[1800,900],0,"Solid","ColorEAST",0.5,""]]]