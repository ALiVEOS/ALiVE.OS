["ALIVEPRESET",2,["Defensive: CSAT invades, NATO holds","NATO holds the ground inside the NATO_AREA marker and CSAT comes to take it. NATO's commander, set to Occupation, spreads its forces over the military objectives in the area and sends help wherever CSAT attacks. CSAT's commander, set to Invasion, starts from a forward base about 3.4 km north of where you drop the preset and attacks the nearest objectives first. Place yourself and your players as NATO inside the area. The area comes with the preset, so it works on any map: drop it over a base or airfield you want to defend.","ALiVE","Altis","3.2.0.2604133","2026-09-26",[14600,16400]],[["ALiVE_require",[],[-16,-12]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-8,-12]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""BLU_F""]"]],[0,-12]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","NATO_AREA"],["ALiVE_mil_placement_faction","BLU_F"],["ALiVE_mil_placement_size","100"]],[8,-12]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","invasion"],["ALiVE_mil_opcom_factions","[""OPF_F""]"]],[0,3412]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_customInfantryCount","16"],["ALiVE_mil_placement_custom_customMotorisedCount","5"],["ALiVE_mil_placement_custom_customMechanisedCount","3"],["ALiVE_mil_placement_custom_customArmourCount","2"],["ALiVE_mil_placement_custom_createFieldHQ","true"]],[0,3400]]],[[2,3],[4,5],[4,3]],[],[],[["NATO_AREA","",0,[0,0],[2000,1300],0,"Solid","ColorWEST",0.5,""]]]