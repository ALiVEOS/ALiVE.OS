["ALIVEPRESET",2,["First steps: one enemy commander","The smallest ALiVE that works: a CSAT commander holding one area, with its forces spread over the military objectives inside it. Place yourself as NATO nearby and attack. The area comes with the preset wherever you put it, so it works on any map; drag it or resize it to choose where the fighting is.","ALiVE","Stratis","3.2.0.2604133","2026-09-24",[3500,5600]],[["ALiVE_require",[]],["ALiVE_sys_profile",[]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""OPF_F""]"]]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","ENEMY_AREA"],["ALiVE_mil_placement_faction","OPF_F"],["ALiVE_mil_placement_size","100"]]]],[[2,3]],[],[],[["ENEMY_AREA","",0,[0,0],[3000,1100],0,"Solid","ColorEAST",0.5,""]]]