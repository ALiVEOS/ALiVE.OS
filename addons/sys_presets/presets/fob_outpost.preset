["ALIVEPRESET",2,["Forward bases: build and hold FOBs","NATO holds the airfield where you drop the preset; CSAT holds the middle and east of the island. Your players push out by deploying their own forward operating bases: drop a FOB kit, build fortifications, supply points, static weapons and later vehicles from the FOB's supply, upgrade it to tier 3 for a garrison and a respawn point, and keep it supplied by Military Logistics trucks or crates. CSAT's commander goes after a FOB once its men find it, and can take one that is left undefended. Sync any object at the airfield, a crate or a flagpole, to the Player FOBs module before you play: that object is the Field HQ where players get FOB kits and supply crates, and a preset can't carry objects.","ALiVE","Stratis","3.2.0.2604133","2026-10-12",[2090,5610]],[["ALiVE_require",[],[-40,-30]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-20,-30]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""BLU_F""]"]],[40,-30]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_factions","[""BLU_F""]"],["ALiVE_mil_placement_custom_size","200"],["ALiVE_mil_placement_custom_customInfantryCount","6"],["ALiVE_mil_placement_custom_customMotorisedCount","2"]],[0,0]],["ALiVE_mil_logistics",[],[60,-30]],["ALiVE_SUP_FOB",[],[20,-30]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""OPF_F""]"]],[2380,-610]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","ENEMY_AREA"],["ALiVE_mil_placement_faction","OPF_F"],["ALiVE_mil_placement_size","100"]],[2410,-610]]],[[2,3],[4,2],[6,7]],[],[],[["ENEMY_AREA","",1,[2410,-610],[1300,1100],0,"Solid","ColorEAST",0.5,""]]]