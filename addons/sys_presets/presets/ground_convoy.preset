["ALIVEPRESET",2,["Ground convoy: transport, escort and recruits","NATO fights north from Camp Tempest, where you drop the preset, towards CSAT's ground round Camp Rogain. Your players have two crewed vehicles on the Combat Support tablet, a HEMTT truck to carry them and an armed Hunter to escort it, and both check the road ahead for IEDs. Agia Marina, on the road north, is seeded with IEDs. Players can recruit soldiers and a Hunter from NATO's force pool. Sync the Recruitment module to a flagpole or crate at the camp before you play: a preset can't carry objects. The vehicles appear exactly where their modules sit, so on another map move those two modules to open, flat ground beside a road.","ALiVE","Stratis","3.2.0.2604133","2026-10-12",[1942,3557]],[["ALiVE_require",[],[-40,-30]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"],["ALiVE_sys_profile_routeMemory","low"]],[-20,-30]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","invasion"],["ALiVE_mil_opcom_factions","[""BLU_F""]"],["ALiVE_mil_opcom_simultanObjectives",2]],[43,43]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_factions","[""BLU_F""]"],["ALiVE_mil_placement_custom_size","150"],["ALiVE_mil_placement_custom_customInfantryCount","8"],["ALiVE_mil_placement_custom_customMotorisedCount","3"],["ALiVE_mil_placement_custom_customMechanisedCount","1"]],[0,0]],["ALiVE_mil_logistics",[],[20,-30]],["ALiVE_sup_combatsupport",[["ALiVE_sup_combatsupport_combatsupport_item","LaserDesignators,Radios"],["ALiVE_sup_combatsupport_combatsupport_singleoperator","0"]],[-62,-57]],["ALiVE_SUP_GROUND",[["ALiVE_sup_ground_ground_callsign","MULE ONE"],["ALiVE_sup_ground_ground_type","B_Truck_01_covered_F"],["ALiVE_sup_ground_ground_disarm_chance","70"],["ALiVE_sup_ground_ground_logistics","1"]],[143,41]],["ALiVE_SUP_GROUND",[["ALiVE_sup_ground_ground_callsign","MULE TWO"],["ALiVE_sup_ground_ground_type","B_MRAP_01_hmg_F"],["ALiVE_sup_ground_ground_disarm_chance","70"],["ALiVE_sup_ground_ground_logistics","1"]],[183,21]],["ALiVE_sup_recruit",[["ALiVE_sup_recruit_vehicleClasses","B_MRAP_01_F"],["ALiVE_sup_recruit_maxVehicles",1],["ALiVE_sup_recruit_unitCost",1],["ALiVE_sup_recruit_vehicleCost",5]],[18,-17]],["ALiVE_mil_ied",[["ALiVE_mil_ied_taor","IED_AREA"],["ALiVE_mil_ied_IED_Threat","100"],["ALiVE_mil_ied_AI_Triggerable","1"]],[60,-30]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""OPF_F""]"]],[2628,1443]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","ENEMY_AREA"],["ALiVE_mil_placement_faction","OPF_F"],["ALiVE_mil_placement_size","100"]],[2658,1443]]],[[2,3],[2,11],[10,11],[4,2],[6,5],[7,5]],[],[],[["ENEMY_AREA","",1,[2658,1443],[1000,1100],0,"Solid","ColorEAST",0.5,""],["IED_AREA","",1,[973,2608],[550,450],0,"Solid","ColorOrange",0.4,""]]]