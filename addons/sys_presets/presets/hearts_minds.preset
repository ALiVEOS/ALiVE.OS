["ALIVEPRESET",2,["Hearts and minds: NATO wins over the towns","NATO works out of a small base where you drop the preset, and the towns inside TOWNS_AREA, about 2 km north, are yours to win over. C2ISTAR hands your players Hearts and Minds tasks there, such as aid deliveries, medical outreach and meeting the local leader, and the civilians can be talked to, given food and water, and show how they feel about you. A light FIA insurgency lives in the same towns: a few groups, a recruitment HQ and an IED area. It recruits more slowly where you're winning and hits back at towns that start to settle. Place yourself and your players as NATO at the base, with an ALiVE Humanitarian Crate or water and rations to hand out. The area comes with the preset, so it works on any map with towns.","ALiVE","Malden","3.2.0.2604133","2026-09-26",[6500,6500]],[["ALiVE_require",[],[-16,-12]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-8,-12]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_factions","[""BLU_F""]"],["ALiVE_mil_placement_custom_customInfantryCount","4"],["ALiVE_mil_placement_custom_customMotorisedCount","2"],["ALiVE_mil_placement_custom_createFieldHQ","true"]],[0,0]],["ALiVE_mil_c2istar",[["ALiVE_MIL_C2ISTAR_autoGenerateBlufor","Constant"],["ALiVE_MIL_C2ISTAR_autoGenerateFactions","BLU_F|OPF_G_F||||"],["ALiVE_MIL_C2ISTAR_civicStateEnabled","true"],["ALiVE_MIL_C2ISTAR_customAutoGeneratedTasks","AidDelivery,SupplyConvoy,MeetLocalLeader,VIPEscort,SecureCommunityEvent,RepairCriticalService,MedicalOutreach,CheckpointPartnership,InformantExfiltration,MarketReopening,RemoveIED,InsurgencyPatrol,InsurgencyDestroyAssets"]],[0,-12]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","FIA"],["ALiVE_mil_opcom_controltype","asymmetric"],["ALiVE_mil_opcom_factions","[""OPF_G_F""]"],["ALiVE_mil_opcom_recruitAttemptLimit",-1],["ALiVE_mil_opcom_asymForceLimit",10],["ALiVE_mil_opcom_civicRecruitmentMultiplier",2],["ALiVE_mil_opcom_civicRetaliationChance",20]],[-12,2000]],["ALiVE_civ_placement",[["ALiVE_civ_placement_taor","TOWNS_AREA"],["ALiVE_civ_placement_faction","OPF_G_F"],["ALiVE_civ_placement_sizeFilter","0"],["ALiVE_civ_placement_size","60"],["ALiVE_civ_placement_type","Infantry"],["ALiVE_civ_placement_guardProbability","0"],["ALiVE_civ_placement_asymmetricInstallationCountOverrides","[[""HQ"",1],[""ied"",1]]"]],[0,2000]],["ALiVE_mil_ied",[["ALiVE_mil_ied_taor","TOWNS_AREA"]],[12,2000]],["ALiVE_amb_civ_placement",[["ALiVE_amb_civ_placement_taor","TOWNS_AREA"],["ALiVE_amb_civ_placement_sizeFilter","0"],["ALiVE_amb_civ_placement_placementMultiplier","1"]],[0,2012]],["ALiVE_amb_civ_population",[["ALiVE_amb_civ_population_hostilityWest","30"],["ALiVE_amb_civ_population_enableInteraction","true"],["ALiVE_amb_civ_population_civHostilityIndicator","DESCRIPTIVE"],["ALiVE_amb_civ_population_ambientCivilianRoles","[ ""major"" , ""priest"" , ""politician"" ]"],["ALiVE_amb_civ_population_humanitarianHostilityChance","40"],["ALiVE_amb_civ_population_insurgentFaction","[""OPF_G_F""]"]],[12,2012]]],[[4,5]],[],[],[["TOWNS_AREA","",1,[0,2000],[1500,1000],0,"Solid","ColorCIV",0.5,""]]]