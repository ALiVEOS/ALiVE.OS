["ALIVEPRESET",2,["Hunt the recruiters: NATO against FIA","FIA insurgents hold the towns inside FIA_AREA, about 2 km north of where you drop the preset, and every one of their recruitment HQs has a recruiter in it with two guards, who walks the town looking for recruits while you are near. Kill a recruiter and his town skips its next recruitment; leave him and it recruits faster. FIA sends suicide bombers at players it spots, and IEDs wait in the towns. NATO works out of a small base at the drop point, with a prison marker (prison_base) where captured insurgents can be questioned for more. Place yourself and your players as NATO at the base. The areas come with the preset, so it works on any map with towns: drag FIA_AREA over the towns you want to clear.","ALiVE","Altis","3.2.0.2604133","2026-10-18",[9000,12500]],[["ALiVE_require",[],[-16,-12]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-8,-12]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_factions","[""BLU_F""]"],["ALiVE_mil_placement_custom_customInfantryCount","4"],["ALiVE_mil_placement_custom_customMotorisedCount","2"],["ALiVE_mil_placement_custom_createFieldHQ","true"]],[0,0]],["ALiVE_mil_c2istar",[["ALiVE_MIL_C2ISTAR_autoGenerateBlufor","Constant"],["ALiVE_MIL_C2ISTAR_autoGenerateFactions","BLU_F|OPF_G_F||||"],["ALiVE_MIL_C2ISTAR_aiSurrenderChance",40],["ALiVE_MIL_C2ISTAR_fieldLieChance",30]],[0,-12]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","FIA"],["ALiVE_mil_opcom_controltype","asymmetric"],["ALiVE_mil_opcom_factions","[""OPF_G_F""]"],["ALiVE_mil_opcom_recruitAttemptLimit",-1],["ALiVE_mil_opcom_asymForceLimit",30],["ALiVE_mil_opcom_recruiters","true"],["ALiVE_mil_opcom_recruiterGuards",2],["ALiVE_mil_opcom_recruiterWalks","true"],["ALiVE_mil_opcom_recruiterBoost","1.5"]],[-12,2200]],["ALiVE_civ_placement",[["ALiVE_civ_placement_taor","FIA_AREA"],["ALiVE_civ_placement_faction","OPF_G_F"],["ALiVE_civ_placement_sizeFilter","0"],["ALiVE_civ_placement_size","100"],["ALiVE_civ_placement_type","Infantry"],["ALiVE_civ_placement_asymmetricInstallationCountOverrides","[[""HQ"",3],[""depot"",1],[""factory"",1],[""ied"",2]]"]],[0,2200]],["ALiVE_mil_ied",[["ALiVE_mil_ied_taor","FIA_AREA"],["ALiVE_mil_ied_IED_Starting_Threat","50"],["ALiVE_mil_ied_Bomber_Threat","20"],["ALiVE_mil_ied_Bomber_Dispatch","true"]],[12,2200]],["ALiVE_mil_cqb",[["ALiVE_mil_cqb_whitelist","FIA_AREA"]],[24,2200]],["ALiVE_amb_civ_placement",[["ALiVE_amb_civ_placement_taor","FIA_AREA"],["ALiVE_amb_civ_placement_sizeFilter","0"],["ALiVE_amb_civ_placement_placementMultiplier","1"]],[0,2212]],["ALiVE_amb_civ_population",[["ALiVE_amb_civ_population_hostilityWest","30"],["ALiVE_amb_civ_population_enableInteraction","true"],["ALiVE_amb_civ_population_insurgentFaction","[""OPF_G_F""]"]],[12,2212]]],[[4,5],[4,6],[4,7]],[],[],[["FIA_AREA","",1,[0,2200],[1200,900],0,"Solid","ColorEAST",0.5,""],["prison_base","",0,[45,35],[25,25],0,"Solid","ColorBLUFOR",0.5,""]]]