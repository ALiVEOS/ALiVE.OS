["ALIVEPRESET",2,["Insurgency: FIA against NATO","FIA insurgents hold the towns inside FIA_AREA, about 3 km north of where you drop the preset, and NATO works out of a forward base at the drop point. The insurgency starts with 2 recruitment HQs, a weapons depot, an IED factory and 2 IED areas, and keeps recruiting from the civilians for as long as an HQ stands, up to 40 groups and vehicles. The civilians start out wary of NATO and can be questioned for intel. NATO's commander, set to Occupation, moves in on the towns. Place yourself and your players as NATO at the base. The area comes with the preset, so it works on any map with towns: drag FIA_AREA over the towns you want fought over.","ALiVE","Altis","3.2.0.2604133","2026-09-26",[14000,15500]],[["ALiVE_require",[],[-16,-12]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-8,-12]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""BLU_F""]"]],[0,-12]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_customInfantryCount","12"],["ALiVE_mil_placement_custom_customMotorisedCount","6"],["ALiVE_mil_placement_custom_customMechanisedCount","4"],["ALiVE_mil_placement_custom_createFieldHQ","true"]],[0,0]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","FIA"],["ALiVE_mil_opcom_controltype","asymmetric"],["ALiVE_mil_opcom_factions","[""OPF_G_F""]"],["ALiVE_mil_opcom_recruitAttemptLimit","-1"],["ALiVE_mil_opcom_asymForceLimit","40"],["ALiVE_mil_opcom_asym_friendlyDisableInstallations","capture"]],[-12,3000]],["ALiVE_civ_placement",[["ALiVE_civ_placement_taor","FIA_AREA"],["ALiVE_civ_placement_faction","OPF_G_F"],["ALiVE_civ_placement_sizeFilter","0"],["ALiVE_civ_placement_size","100"],["ALiVE_civ_placement_type","Infantry"],["ALiVE_civ_placement_asymmetricInstallationCountOverrides","[[""HQ"",2],[""depot"",1],[""factory"",1],[""ied"",2]]"]],[0,3000]],["ALiVE_mil_ied",[["ALiVE_mil_ied_taor","FIA_AREA"]],[12,3000]],["ALiVE_mil_cqb",[["ALiVE_mil_cqb_whitelist","FIA_AREA"]],[24,3000]],["ALiVE_amb_civ_placement",[["ALiVE_amb_civ_placement_taor","FIA_AREA"],["ALiVE_amb_civ_placement_sizeFilter","0"],["ALiVE_amb_civ_placement_placementMultiplier","1"]],[0,3012]],["ALiVE_amb_civ_population",[["ALiVE_amb_civ_population_hostilityWest","30"],["ALiVE_amb_civ_population_enableInteraction","true"],["ALiVE_amb_civ_population_insurgentFaction","[""OPF_G_F""]"]],[12,3012]]],[[2,3],[2,5],[4,5],[4,6],[4,7]],[],[],[["FIA_AREA","",1,[0,3000],[1300,1000],0,"Solid","ColorEAST",0.5,""]]]