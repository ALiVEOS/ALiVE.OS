["ALIVEPRESET",2,["Insurgency campaign: FIA against NATO","FIA insurgents hold the towns inside FIA_AREA, 2 to 3 km north of where you drop the preset, and NATO works out of a forward base at the drop point. On Altis it drops at the main airbase, and the area covers Gravia, Telos and Athira. The insurgency starts with 2 recruitment HQs, a weapons depot, an IED factory and 2 IED areas, and keeps recruiting from the civilians for as long as an HQ stands, up to 40 groups and vehicles. The civilians start out wary of NATO and can be questioned for intel. NATO's commander, set to Occupation, moves in on the towns. Place yourself and your players as NATO at the base. The area comes with the preset, so it works on any map with towns: drag FIA_AREA over the towns you want fought over. Saving is on: the profiles, both commanders and player saves are kept, with an autosave every 15 minutes. By Mendigoo, adjusted by the ALiVE team: vanilla FIA in place of Tura, and a smaller FIA_AREA.","Mendigoo","Altis","3.2.0.2604133","2026-11-05",[14000,15500]],[["ALiVE_require",[],[1852,-1800]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"],["ALiVE_sys_profile_persistent","true"]],[1860,-1800]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""BLU_F""]"],["ALiVE_mil_opcom_persistent","true"]],[1868,-1800]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_customInfantryCount","12"],["ALiVE_mil_placement_custom_customMotorisedCount","6"],["ALiVE_mil_placement_custom_customMechanisedCount","4"],["ALiVE_mil_placement_custom_createFieldHQ","true"]],[1868,-1788]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","FIA"],["ALiVE_mil_opcom_controltype","asymmetric"],["ALiVE_mil_opcom_factions","[""OPF_G_F""]"],["ALiVE_mil_opcom_recruitAttemptLimit",-1],["ALiVE_mil_opcom_asymForceLimit",40],["ALiVE_mil_opcom_asym_friendlyDisableInstallations","capture"],["ALiVE_mil_opcom_recruiters","true"],["ALiVE_mil_opcom_recruiterWalks","true"],["ALiVE_mil_opcom_persistent","true"]],[1856,1212]],["ALiVE_civ_placement",[["ALiVE_civ_placement_taor","FIA_AREA"],["ALiVE_civ_placement_faction","OPF_G_F"],["ALiVE_civ_placement_sizeFilter","0"],["ALiVE_civ_placement_size","100"],["ALiVE_civ_placement_type","Infantry"],["ALiVE_civ_placement_asymmetricInstallationCountOverrides","[[""HQ"",2],[""depot"",1],[""factory"",1],[""ied"",2]]"]],[1868,1212]],["ALiVE_mil_ied",[["ALiVE_mil_ied_taor","FIA_AREA"]],[1880,1212]],["ALiVE_mil_cqb",[["ALiVE_mil_cqb_whitelist","FIA_AREA"]],[1892,1212]],["ALiVE_amb_civ_placement",[["ALiVE_amb_civ_placement_taor","FIA_AREA"],["ALiVE_amb_civ_placement_sizeFilter","0"],["ALiVE_amb_civ_placement_placementMultiplier","1"]],[1868,1224]],["ALiVE_amb_civ_population",[["ALiVE_amb_civ_population_hostilityWest","30"],["ALiVE_amb_civ_population_enableInteraction","true"],["ALiVE_amb_civ_population_insurgentFaction","[""OPF_G_F""]"]],[1880,1224]],["ALiVE_sup_cas",[["ALiVE_sup_cas_cas_logistics","1"]],[-310,50]],["ALiVE_sup_combatsupport",[["ALiVE_sup_combatsupport_combatsupport_item","LaserDesignators,Radios"],["ALiVE_sup_combatsupport_combatsupport_singleoperator","0"]],[-290,80]],["ALiVE_sup_artillery",[["ALiVE_sup_artillery_artillery_logistics","1"],["ALiVE_sup_artillery_artillery_relocate","1"]],[-330,-170]],["ALiVE_SUP_TRANSPORT",[["ALiVE_sup_transport_transport_logistics","1"]],[-310,110]],["ALiVE_SUP_PLAYER_RESUPPLY",[["ALiVE_sup_player_resupply_pr_item","LaserDesignators,Radios"]],[40,-30]],["ALiVE_sys_data",[["ALiVE_sys_data_source","pns"],["ALiVE_sys_data_saveDateTime","true"],["ALiVE_sys_data_autoSaveInterval",15]],[0,-30]],["ALiVE_SYS_playeroptions",[["ALiVE_SYS_playeroptions_storeToDB","true"]],[20,-30]]],[[2,3],[2,5],[4,5],[4,7],[10,11],[12,11],[13,11]],[],[],[["FIA_AREA","",1,[900,2400],[2000,1600],0,"Solid","ColorEAST",0.5,""]]]
