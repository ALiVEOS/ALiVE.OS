["ALIVEPRESET",1,["Island campaign: NATO holds the whole island, with support and saves","A NATO commander that takes and holds the whole island, its forces spread across the military objectives the map index turns up, with CAS, artillery, transport and player resupply, and the campaign saved as it goes. Somewhere to start from: drop in your own playable units, or swap NATO for a faction that suits a different map. On a big map like Altis this is a heavy load for the server.","theone89","Altis","3.2.0.2604133","2026-11-10",[20825,7251]],[["ALiVE_require",[]],["ALiVE_sys_profile",[["ALiVE_sys_profile_persistent","true"]]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""BLU_F""]"],["ALiVE_mil_opcom_persistent","true"]]],["ALiVE_mil_placement",[]],["ALiVE_sys_aiskill",[["ALiVE_sys_aiskill_skillTierFactions","recruit:;regular:BLU_F;veteran:;expert:;custom:"]],[-60,-50]],["ALiVE_sup_cas",[["ALiVE_sup_cas_cas_logistics","1"]],[-310,50]],["ALiVE_sup_combatsupport",[["ALiVE_sup_combatsupport_combatsupport_item","LaserDesignators,Radios"],["ALiVE_sup_combatsupport_combatsupport_singleoperator","0"]],[-290,80]],["ALiVE_sup_artillery",[["ALiVE_sup_artillery_artillery_logistics","1"],["ALiVE_sup_artillery_artillery_relocate","1"]],[-330,-170]],["ALiVE_SUP_TRANSPORT",[["ALiVE_sup_transport_transport_logistics","1"]],[-310,110]],["ALiVE_SUP_PLAYER_RESUPPLY",[["ALiVE_sup_player_resupply_pr_item","LaserDesignators,Radios"]],[40,-30]],["ALiVE_sys_data",[["ALiVE_sys_data_source","pns"],["ALiVE_sys_data_saveDateTime","true"],["ALiVE_sys_data_autoSaveInterval",15]],[0,-30]],["ALiVE_SYS_playeroptions",[["ALiVE_SYS_playeroptions_storeToDB","true"]],[20,-30]]],[[2,3],[5,6],[7,6],[8,6]],[],[],[]]
