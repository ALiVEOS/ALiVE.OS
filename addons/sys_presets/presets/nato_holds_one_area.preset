["ALIVEPRESET",2,["NATO holds one area of the island","A NATO commander that fights inside one TAOR marker instead of across the whole island. The marker is part of the preset, so it arrives where you drop the preset and at the size it was saved with. Drag it or resize it before you start and the commander takes its objectives from the new boundary.","ALiVE","Stratis","3.2.0.2604133","2026-09-21"],[["ALiVE_require",[]],["ALiVE_sys_profile",[]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""BLU_F""]"]]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","BLUFOR_TAOR"]]]],[[2,3]],[],[],[["BLUFOR_TAOR","",0,[0,0],[2509,1679],0,"Solid","ColorWEST",0.77,""]]]
