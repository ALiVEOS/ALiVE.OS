["ALIVEPRESET",2,["Offensive: NATO attacks CSAT-held ground","NATO goes on the offensive. Its commander, set to Invasion, starts from a forward base where you drop the preset and attacks the objectives inside the ENEMY_AREA marker, nearest first, while a CSAT commander set to Occupation holds them and tries to take back what it loses. Place yourself and your players as NATO at the base. The area comes with the preset, so it works on any map: move it over a base or airfield to choose what is being fought for.","ALiVE","Malden","3.2.0.2604133","2026-09-26",[6600,7600]],[["ALiVE_require",[],[-16,-12]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-8,-12]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","invasion"],["ALiVE_mil_opcom_factions","[""BLU_F""]"],["ALiVE_mil_opcom_simultanObjectives",3],["ALiVE_mil_opcom_taskProfileCountOverrides","[[""attack"",8]]"]],[0,-12]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_customInfantryCount","16"],["ALiVE_mil_placement_custom_customMotorisedCount","6"],["ALiVE_mil_placement_custom_customMechanisedCount","4"],["ALiVE_mil_placement_custom_customArmourCount","2"],["ALiVE_mil_placement_custom_createFieldHQ","true"]],[0,0]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""OPF_F""]"]],[0,3300]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","ENEMY_AREA"],["ALiVE_mil_placement_faction","OPF_F"],["ALiVE_mil_placement_size","100"]],[8,3300]]],[[2,3],[2,5],[4,5]],[],[],[["ENEMY_AREA","",0,[0,2700],[1700,800],0,"Solid","ColorEAST",0.5,""]]]