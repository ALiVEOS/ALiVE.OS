["ALIVEPRESET",2,["Outbreak: zombies hold an area","The Outbreak game mode with WebKnight's zombies: a zombie commander holding one area, its hordes spread over the military objectives and the towns inside it, at war with every side, and hunting the townspeople, who get up as zombies when bitten to death. Needs WebKnight's Zombies and Creatures and Improved Melee System loaded. Place yourself as NATO nearby and fight your way in. The area comes with the preset wherever you put it, so it works on any map.","ALiVE","Stratis","3.2.0.2604133","2026-10-28",[3500,5600]],[["ALiVE_require",[["ALiVE_require_ALiVE_GAMEMODE","outbreak"],["ALiVE_require_ALiVE_ZOMBIESIDE","EAST"]]],["ALiVE_sys_profile",[["ALiVE_sys_profile_zombieFactions","WBK_AI_ZHAMBIES"]]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","Zombies"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""WBK_AI_ZHAMBIES""]"]]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","ZOMBIE_AREA"],["ALiVE_mil_placement_faction","WBK_AI_ZHAMBIES"],["ALiVE_mil_placement_size","100"]]],["ALiVE_civ_placement",[["ALiVE_civ_placement_taor","ZOMBIE_AREA"],["ALiVE_civ_placement_faction","WBK_AI_ZHAMBIES"],["ALiVE_civ_placement_size","100"]]],["ALiVE_amb_civ_placement",[["ALiVE_amb_civ_placement_taor","ZOMBIE_AREA"],["ALiVE_amb_civ_placement_placementMultiplier","1"]]],["ALiVE_amb_civ_population",[]]],[[2,3],[2,4]],[],[],[["ZOMBIE_AREA","",0,[0,0],[3000,1100],0,"Solid","ColorEAST",0.5,""]]]