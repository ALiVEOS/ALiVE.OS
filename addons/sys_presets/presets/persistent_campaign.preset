["ALIVEPRESET",2,["Persistent campaign: a war that carries on where you saved","NATO holds Malden's airport, where you drop the preset, and attacks CSAT's ground in the south round Chapoi and Le Port. Saving is set up in full: ALiVE Data saves locally every 15 minutes along with the mission's date and time, and the AI forces, both commanders, Military Logistics, C2ISTAR's tasks and each player's kit and position are all kept. Load the mission again and the war picks up where it was. On a dedicated server, use SERVER SAVE AND EXIT from the Esc menu before a restart. Place yourself and your players as NATO at the airport.","ALiVE","Malden","3.2.0.2604133","2026-10-12",[7943,9410]],[["ALiVE_require",[],[-40,-30]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"],["ALiVE_sys_profile_persistent","true"]],[-20,-30]],["ALiVE_sys_data",[["ALiVE_sys_data_source","pns"],["ALiVE_sys_data_saveDateTime","true"],["ALiVE_sys_data_autoSaveInterval","15"]],[0,-30]],["ALiVE_SYS_playeroptions",[["ALiVE_SYS_playeroptions_storeToDB","true"]],[20,-30]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","invasion"],["ALiVE_mil_opcom_factions","[""BLU_F""]"],["ALiVE_mil_opcom_persistent","true"]],[97,290]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_factions","[""BLU_F""]"],["ALiVE_mil_placement_custom_size","200"],["ALiVE_mil_placement_custom_customInfantryCount","10"],["ALiVE_mil_placement_custom_customMotorisedCount","4"],["ALiVE_mil_placement_custom_customMechanisedCount","2"],["ALiVE_mil_placement_custom_customArmourCount","1"],["ALiVE_mil_placement_custom_createFieldHQ","true"]],[0,0]],["ALiVE_mil_logistics",[["ALiVE_mil_logistics_persistent","true"]],[40,-30]],["ALiVE_mil_c2istar",[["ALiVE_MIL_C2ISTAR_persistent","true"]],[60,-30]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""OPF_F""]"],["ALiVE_mil_opcom_persistent","true"]],[-1773,-6010]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","ENEMY_AREA"],["ALiVE_mil_placement_faction","OPF_F"],["ALiVE_mil_placement_size","100"]],[-1743,-6010]],["ALiVE_civ_placement",[["ALiVE_civ_placement_taor","ENEMY_AREA"],["ALiVE_civ_placement_faction","OPF_F"],["ALiVE_civ_placement_size","100"]],[-1703,-5980]]],[[4,5],[4,9],[4,10],[8,9],[8,10],[6,4]],[],[],[["ENEMY_AREA","",1,[-1743,-6010],[1700,1100],0,"Solid","ColorEAST",0.5,""]]]