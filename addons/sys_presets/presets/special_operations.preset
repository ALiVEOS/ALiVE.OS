["ALIVEPRESET",2,["Special operations: a small team against a held town","A small NATO team at an outpost east of Kavala, where you drop the preset. CSAT holds Kavala, Aggelochori and Neri, with garrisons in the houses for close-quarters fighting. There's no NATO commander: C2ISTAR hands your team one task at a time from the small-team jobs only (assassination, sabotage, demolition, rescue, wiretap, clearing infantry and raids), and beaten enemy soldiers can surrender and be questioned for intel. Place yourself and your players as NATO at the outpost. On another map, move CSAT_AREA over a town.","ALiVE","Altis","3.2.0.2604133","2026-10-12",[5000,13300]],[["ALiVE_require",[],[-40,-30]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-20,-30]],["ALiVE_mil_placement_custom",[["ALiVE_mil_placement_custom_factions","[""BLU_F""]"],["ALiVE_mil_placement_custom_size","80"],["ALiVE_mil_placement_custom_customInfantryCount","2"],["ALiVE_mil_placement_custom_customMotorisedCount","1"],["ALiVE_mil_placement_custom_customMechanisedCount","0"],["ALiVE_mil_placement_custom_customArmourCount","0"]],[0,0]],["ALiVE_mil_c2istar",[["ALiVE_MIL_C2ISTAR_autoGenerateBlufor","Constant"],["ALiVE_MIL_C2ISTAR_autoGenerateFactions","BLU_F|OPF_F||||"],["ALiVE_MIL_C2ISTAR_customAutoGeneratedTasks","Assassination,SabotageBuilding,DestroyBuilding,Rescue,Wiretap,DestroyInfantry,CivAssault"],["ALiVE_MIL_C2ISTAR_aiSurrenderChance",25]],[0,-30]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""OPF_F""]"]],[-1340,-600]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","CSAT_AREA"],["ALiVE_mil_placement_faction","OPF_F"],["ALiVE_mil_placement_size","100"]],[-1300,-600]],["ALiVE_civ_placement",[["ALiVE_civ_placement_taor","CSAT_AREA"],["ALiVE_civ_placement_faction","OPF_F"],["ALiVE_civ_placement_size","100"]],[-1260,-570]],["ALiVE_mil_cqb",[["ALiVE_mil_cqb_whitelist","CSAT_AREA"],["ALiVE_mil_cqb_CQB_TYPE","regular"],["ALiVE_mil_cqb_CQB_spawn_setting","0.05"]],[-1300,-640]]],[[4,5],[4,6],[7,5],[7,6]],[],[],[["CSAT_AREA","",1,[-1300,-600],[1100,1300],0,"Solid","ColorEAST",0.5,""]]]