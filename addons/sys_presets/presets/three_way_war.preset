["ALIVEPRESET",2,["Three-way war: NATO, CSAT and AAF","NATO, CSAT and AAF each hold ground of their own and fight each other for the rest. Each side has a commander set to Occupation and a Military Placement holding the military objectives in its area: NATO_AREA about 3 km south-west of where you drop the preset, CSAT_AREA 3 km north and AAF_AREA 3 km south-east. Every placement is synced to all three commanders, so each one knows the other two sides' objectives as well as its own. Before you play, open Attributes > General > Misc and set Independents Allegiance so AAF is the enemy of both BLUFOR and OPFOR: a new scenario makes AAF friendly to NATO, and then it's two against one. The areas come with the preset, so it works on any map big enough for all three, such as Altis or Malden, as long as each area has military sites in it.","ALiVE","Altis","3.2.0.2604133","2026-09-26",[9000,16000]],[["ALiVE_require",[],[-16,-12]],["ALiVE_sys_profile",[["ALiVE_sys_profile_virtualcombat_speedmodifier","0.75"]],[-8,-12]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","NATO"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""BLU_F""]"]],[-2610,-1500]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","NATO_AREA"],["ALiVE_mil_placement_faction","BLU_F"],["ALiVE_mil_placement_size","100"]],[-2598,-1500]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","CSAT"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""OPF_F""]"]],[-12,3000]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","CSAT_AREA"],["ALiVE_mil_placement_faction","OPF_F"],["ALiVE_mil_placement_size","100"]],[0,3000]],["ALiVE_mil_OPCOM",[["ALiVE_mil_opcom_customName","AAF"],["ALiVE_mil_opcom_controltype","occupation"],["ALiVE_mil_opcom_factions","[""IND_F""]"]],[2586,-1500]],["ALiVE_mil_placement",[["ALiVE_mil_placement_taor","AAF_AREA"],["ALiVE_mil_placement_faction","IND_F"],["ALiVE_mil_placement_size","100"]],[2598,-1500]]],[[2,3],[2,5],[2,7],[4,3],[4,5],[4,7],[6,3],[6,5],[6,7]],[],[],[["NATO_AREA","",1,[-2598,-1500],[1600,1200],0,"Solid","ColorWEST",0.5,""],["CSAT_AREA","",1,[0,3000],[1600,1200],0,"Solid","ColorEAST",0.5,""],["AAF_AREA","",1,[2598,-1500],[1600,1200],0,"Solid","ColorGUER",0.5,""]]]